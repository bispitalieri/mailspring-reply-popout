{
  "name": "mailspring-reply-popout",
  "displayName": "Reply Pop-out",
  "version": "1.0.0",
  "description": "Automatically opens email replies, reply-alls, and forwards in detached native Electron composer windows instead of inline.",
  "author": "bspitalieri",
  "license": "MIT",
  "main": "./lib/main.js",
  "windowTypes": {
    "default": true
  },
  "engines": {
    "mailspring": ">=1.7.0"
  },
  "keywords": [
    "mailspring",
    "plugin",
    "reply",
    "reply-all",
    "forward",
    "composer",
    "popout",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bispitalieri/mailspring-reply-popout"
  },
  "scripts": {
    "zip": "zip -r mailspring-reply-popout.zip . -x '*.git*' '*.idea*' '*.DS_Store*' 'node_modules/*'",
    "sha": "shasum -a 256 mailspring-reply-popout.zip > mailspring-reply-popout.zip.sha256",
    "release": "npm run zip && npm run sha"
  }
}
